<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- parallel="tests": each <test> block below runs on its own thread, 4 at a time.
     Methods inside one class still run in order on one thread (BookingTest chain is safe). -->
<suite name="Restful Booker API Suite" verbose="1" parallel="tests" thread-count="4">
    <!-- Re-run any failed test once to avoid false failures from the public API -->
    <listeners>
        <listener class-name="com.kanhaiya.api.listeners.RetryListener"/>
    </listeners>
    <test name="Smoke Tests">
        <classes>
            <class name="com.kanhaiya.api.tests.SmokeTest"/>
        </classes>
    </test>
    <test name="Auth Tests">
        <classes>
            <class name="com.kanhaiya.api.tests.AuthTest"/>
        </classes>
    </test>
    <test name="Booking CRUD Tests">
        <classes>
            <class name="com.kanhaiya.api.tests.BookingTest"/>
        </classes>
    </test>
    <test name="Booking Edge Case Tests">
        <classes>
            <class name="com.kanhaiya.api.tests.BookingEdgeCaseTest"/>
        </classes>
    </test>
    <test name="Sanity Tests">
        <classes>
            <class name="com.kanhaiya.api.tests.SanityTest"/>
        </classes>
    </test>
    <test name="Schema Validation Tests">
        <classes>
            <class name="com.kanhaiya.api.tests.SchemaValidationTest"/>
        </classes>
    </test>
    <test name="Booking Data-Driven Tests">
        <classes>
            <class name="com.kanhaiya.api.tests.BookingDataDrivenTest"/>
        </classes>
    </test>
    <test name="Booking E2E Tests">
        <classes>
            <class name="com.kanhaiya.api.tests.BookingE2ETest"/>
        </classes>
    </test>
</suite>
